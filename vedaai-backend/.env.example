PORT=5000

# MongoDB (local or Atlas) — include database name before ? query params
# MONGO_URI=mongodb://127.0.0.1:27017/vedaai
# MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/vedaai?retryWrites=true&w=majority
MONGO_URI=

# Redis (hosted — required for BullMQ background jobs). Do NOT use localhost unless Redis is installed.
# Upstash (recommended, free tier): copy "Redis URL" from dashboard — usually starts with rediss://
# REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379
# Redis Cloud:
# REDIS_URL=redis://default:YOUR_PASSWORD@redis-12345.redis.cloud:12345
REDIS_URL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
